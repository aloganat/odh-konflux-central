# Unified Dockerfile – select build mode via BUILD_MODE arg
ARG BUILD_MODE=ODH

# ============================================================
# ODH Build
# ============================================================
FROM registry.access.redhat.com/ubi9/python-312:1 AS odh-stage-0

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_CACHE_DIR=/tmp/uv-cache
COPY requirements.txt requirements.txt
RUN uv pip install -r requirements.txt

# modify permissions to support running with a random uid
RUN chmod g+w $(python -c "import feast.ui as ui; print(ui.__path__)" | tr -d "[']")/build/projects-list.json


# ============================================================
# RHOAI Build
# ============================================================
FROM registry.access.redhat.com/ubi9/python-311@sha256:9d3578927c6168e364f963b642fb15d5c4b1224a31c11da2ae970f05708724ae AS rhoai-stage-0

# OS Packages needs to be installed as root
USER 0

# Upgrade base packages for consistency across all arches
RUN dnf upgrade -y --refresh && dnf clean all

# Copy Power prebuild script
COPY prebuild-power.sh /prebuild-power.sh
RUN chmod +x /prebuild-power.sh

# Run prebuild script conditionally (Power only)
RUN if [ "$(uname -m)" = "ppc64le" ]; then \
        echo "Power architecture detected. Running prebuild script..."; \
        /prebuild-power.sh && pip install /wheelhouse/*.whl; \
        echo "Listing built wheels:" && ls -lh /wheelhouse; \
    else \
        echo "Non-Power architecture detected; skipping Power prebuild"; \
    fi

COPY requirements.txt requirements.txt
RUN pip install -r requirements.txt

# modify permissions to support running with a random uid
RUN chmod g+w $(python -c "import feast.ui as ui; print(ui.__path__)" | tr -d "[']")/build/projects-list.json

# default user
USER 1001

LABEL com.redhat.component="odh-feature-server" \
      name="odh-feature-server-rhel9" \
      description="odh-feature-server" \
      summary="odh-feature-server" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-feature-server" \
      io.k8s.description="odh-feature-server"


# ============================================================
# Stage selector – picks the build based on BUILD_MODE
# ============================================================
FROM ${odh-stage-0} AS odh-output
FROM ${rhoai-stage-0} AS rhoai-output

ARG BUILD_MODE=ODH
FROM ${BUILD_MODE}-output AS final
