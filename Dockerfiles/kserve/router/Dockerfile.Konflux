ARG BUILD_MODE=ODH

ARG BASE_IMAGE_ODH=registry.access.redhat.com/ubi9/go-toolset:1.25
ARG BASE_IMAGE_RHOAI=registry.access.redhat.com/ubi9/go-toolset:1.24
ARG BASE_IMAGE=${BASE_IMAGE_${BUILD_MODE}}
FROM ${BASE_IMAGE} AS builder

# Copy in the go src
WORKDIR /go/src/github.com/kserve/kserve
COPY go.mod  go.mod
COPY go.sum  go.sum

RUN go mod download

COPY cmd/    cmd/
COPY pkg/    pkg/

# Build
USER root
RUN if [ "$BUILD_MODE" = "RHOAI" ]; then \
      CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFLAGS=-mod=mod GOEXPERIMENT=strictfipsruntime go build -tags strictfipsruntime -a -o manager ./cmd/manager ; \
    else \
      CGO_ENABLED=0  go build -a -o router ./cmd/router ; \
    fi

# >>> [ODH] <<<
# Generate third-party licenses
COPY LICENSE LICENSE
RUN go install github.com/google/go-licenses@latest
# Forbidden Licenses: https://github.com/google/licenseclassifier/blob/e6a9bb99b5a6f71d5a34336b8245e305f5430f99/license_type.go#L341
RUN /opt/app-root/src/go/bin/go-licenses check ./cmd/... ./pkg/... --disallowed_types="forbidden,unknown"
RUN /opt/app-root/src/go/bin/go-licenses save --save_path third_party/library ./cmd/router
# >>> [END ODH] <<<
# >>> [RHOAI] <<<
# Use distroless as minimal base image to package the manager binary
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
# >>> [END RHOAI] <<<

# >>> [ODH] <<<
# Copy the inference-router into a thin image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
# >>> [END ODH] <<<
RUN microdnf install -y --disablerepo=* --enablerepo=ubi-9-baseos-rpms shadow-utils && \
    microdnf clean all && \
    useradd kserve -m -u 1000
RUN microdnf remove -y shadow-utils

# >>> [ODH] <<<
COPY --from=builder /go/src/github.com/kserve/kserve/third_party /third_party

WORKDIR /ko-app

COPY --from=builder /go/src/github.com/kserve/kserve/router /ko-app/
# >>> [END ODH] <<<
# >>> [RHOAI] <<<
COPY third_party_manager/ third_party/
COPY --from=builder /go/src/github.com/kserve/kserve/manager /
# >>> [END RHOAI] <<<
USER 1000:1000

# >>> [ODH] <<<
ENTRYPOINT ["/ko-app/router"]
# >>> [END ODH] <<<
# >>> [RHOAI] <<<
ENTRYPOINT ["/manager"]

LABEL com.redhat.component="odh-kserve-controller" \
      name="odh-kserve-controller" \
      description="odh-kserve-controller" \
      summary="odh-kserve-controller" \
      io.k8s.display-name="odh-kserve-controller" \
      io.k8s.description="odh-kserve-controller"
# >>> [END RHOAI] <<<
